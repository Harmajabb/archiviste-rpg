# Copie ce fichier en ".env" puis remplis les valeurs.
# Ne partage JAMAIS ton fichier .env (ni sur GitHub, ni sur Discord).

# Developer Portal > ton application > Bot > Reset Token
DISCORD_TOKEN=

# Developer Portal > ton application > General Information > Application ID
CLIENT_ID=

# Facultatif : ton serveur de test, pour "npm run deploy:dev".
# Discord (mode développeur activé) > clic droit sur ton serveur > Copier l'identifiant
GUILD_ID=
